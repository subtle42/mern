{
    "extends": "../tsconfig",
    "compilerOptions": {
        "types": ["node"],
        "target": "es6",
        "outDir": ".dist",
        "module": "commonjs",
        "sourceMap": false,
        "resolveJsonModule": true,
        "esModuleInterop": true
    },
    "exclude": [
        "node_modules"
    ],
    "include": [
        "./**/*"
    ]
}