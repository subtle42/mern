{
  "name": "automation",
  "version": "1.0.0",
  "description": "",
  "scripts": {
    "test": "npm run test --workspaces",
    "build": "npm run build --workspaces"
  },
  "author": "",
  "workspaces": [
    "server",
    "client"
  ],
  "license": "ISC",
  "nyc": {
    "include": [
      "**/*.ts",
      "**/*.tsx"
    ],
    "exclude": [
      "./integration/**/*",
      "./common/**/*",
      "./e2e/**/*",
      "**/*.spec.*",
      "**/model.ts"
    ],
    "extension": [
      ".ts",
      ".tsx"
    ],
    "require": [
      "ts-node/register",
      "source-map-support/register"
    ],
    "reporter": [
      "text-summary",
      "html"
    ],
    "sourceMap": true,
    "instrument": true
  },
  "allowScripts": {
    "mongodb-memory-server@11.2.0": true,
    "esbuild@0.28.2": true
  }
}
